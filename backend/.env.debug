# Debug environment configuration
# Copy this to .env for development debugging

# Enable debug mode
DEBUG=true

# Server settings for debugging
HOST=127.0.0.1
PORT=8000

# Verbose logging
LOG_LEVEL=DEBUG

# Ollama settings
OLLAMA_URL=http://localhost:11434

# Model settings (use smaller/faster models for debugging)
ROUTER_MODEL=phi:latest
CODE_MODEL=codellama:7b
SIMPLE_MODEL=mistral:7b
COMPLEX_MODEL=llama3:8b

# Use internal router for debugging (faster)
USE_LANGCHAIN_ROUTER=false

# Log file
LOG_FILE=debug.log
