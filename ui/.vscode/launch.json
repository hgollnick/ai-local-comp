{
  "version": "0.2.0",
  "configurations": [
    {
      // 1. Just launches the Vite dev server
      "type": "node",
      "request": "launch",
      "name": "Start Vite Dev Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal"
    },
    {
      // 1b. Launches Vite dev server with Node.js inspector enabled for debugging
      "type": "node",
      "request": "launch",
      "name": "Start Vite Dev Server (Debug Mode)",
      "runtimeExecutable": "node",
      "args": ["--inspect=9229", "./node_modules/vite/bin/vite.js"],
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      // 2. Debugs the Vite process (Node-based Vite plugins, etc.)
      "type": "node",
      "request": "attach",
      "name": "Attach to Vite for Debugging",
      "port": 9229,
      "restart": true,
      "timeout": 10000
    }
  ]
}
